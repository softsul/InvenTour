# Portal público de cada destino (<slug>.inventour.com.br ou domínio próprio).
# Softsul Software
#
# Na fundação só existe a página provisória e a política de privacidade. As
# rotas do web app do destino (oferta, atrativos, mapa, QR) entram aqui
# quando o módulo ficar pronto.

Options -Indexes +FollowSymLinks
DirectoryIndex index.php
RewriteEngine On

# Endereço com .php vira o limpo.
RewriteCond %{THE_REQUEST} \s/+([^?\s]+)\.php[\s?] [NC]
RewriteRule ^ /%1 [R=301,L,NE]

# /pagina serve pagina.php, desde que o arquivo exista.
# Etapa 5: os pilares, a ficha, o roteiro, o ponto de QR da cidade, a cor,
# a foto do destino, o sitemap e o robots.
RewriteRule ^(onde-dormir|onde-comer|o-que-fazer|servicos)/?$ /pilar.php?p=$1 [L,QSA]
RewriteRule ^busca/?$ /pilar.php [L,QSA]
RewriteRule ^lugar/([0-9]+)(?:-[^/]*)?/?$ /lugar.php?id=$1 [L,QSA]
RewriteRule ^roteiro/([0-9]+)(?:-[^/]*)?/?$ /roteiro.php?id=$1 [L,QSA]
RewriteRule ^qr/([a-z0-9-]{2,40})/?$ /ponto.php?a=$1 [L,QSA]
RewriteRule ^acento\.css$ /acento.php [L,QSA]
RewriteRule ^capa\.jpg$ /capa.php [L]
RewriteRule ^sitemap\.xml$ /sitemap.php [L]
RewriteRule ^robots\.txt$ /robots.php [L]
# Bing Webmaster (código de verificação de cada portal) e a chave do IndexNow
# (app/Bing.php), como no EventCity.
# Contadores de métrica sem cookie (portal/m.php), como no EventCity.
RewriteRule ^m/([a-z]{2,10})/([0-9]{1,10})$ /m.php?acao=$1&id=$2 [L,QSA]
RewriteRule ^BingSiteAuth\.xml$ /bing-auth.php [L]
RewriteRule ^([a-f0-9]{32})\.txt$ /indexnow.php?chave=$1 [L]

# QR das fichas do caderno (/qr/CODIGO/item) e verificação (/verificar/CODIGO).
RewriteRule ^qr/([A-Za-z0-9]{10})/([0-9]+)/?$ /qr.php?c=$1&i=$2 [L,QSA]
RewriteRule ^verificar/([A-Za-z0-9-]{10,12})/?$ /verificar.php?c=$1 [L,QSA]

RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{DOCUMENT_ROOT}/$1.php -f
RewriteRule ^(.+?)/?$ /$1.php [L]

# Bloco do mapa base que não existe (mar, fora do recorte): 404, nunca a
# página inicial (o mapa leria HTML como bloco).
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^mapa-base/ - [R=404,L]

# Qualquer outro endereço cai na página inicial do destino.
RewriteCond %{REQUEST_FILENAME} !-f
RewriteRule ^ index.php [L]

# Mapa base do destino: blocos vetoriais do OpenStreetMap (scripts/gerar_mapa_base.mjs)
# e as fontes dos rótulos. Mudam só quando o recorte é refeito.
AddType application/x-protobuf .pbf
<IfModule mod_expires.c>
    <FilesMatch "\.pbf$">
        ExpiresActive On
        ExpiresDefault "access plus 7 days"
    </FilesMatch>
</IfModule>

<FilesMatch "^\.">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.google.com https://www.gstatic.com; style-src 'self'; img-src 'self' data: https://www.gstatic.com https://app.eventcity.com.br https://*.eventcity.com.br https://*.google-analytics.com https://*.googletagmanager.com; font-src 'self'; connect-src 'self' https://www.google.com https://*.google-analytics.com https://*.analytics.google.com https://*.googletagmanager.com; object-src 'none'; base-uri 'self'; form-action 'self'; frame-src https://www.google.com https://recaptcha.google.com; frame-ancestors 'self'"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "geolocation=(self), microphone=(), camera=(), payment=()"
</IfModule>

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/css text/javascript application/javascript image/svg+xml application/json application/x-protobuf
</IfModule>
