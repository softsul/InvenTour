# Configuração real, com senha do banco e chave de cifra. O modelo sem
# segredos é o app/config.exemplo.php.
/app/config.php

# Tudo que a aplicação escreve em tempo de execução: sessões, mídias,
# cache de página, PDFs, logs.
/storage/
/logs/

# Pacotes do composer (SDK da IA, travada até o destino pôr o token dele).
/vendor/

# Versão gerada pelo gancho do git (scripts/gerar-versao.sh).
/public/versao.json
/public/.versao.json.tmp

*.swp
*~
.DS_Store

# Material do Drive (zip e arquivos extraídos): grande e com documentos de terceiros.
/docs/material-original/

# Downloads do app (APK e AAB gerados pelo mobile/campo/publicar-apk.sh).
/public/baixar/
__pycache__/
docs/especificacao/fichas-2011/texto-dos-pdfs/

# Mapa base de cada destino (blocos do OpenStreetMap, ~10 MB): gerado por
# scripts/gerar_mapa_base.mjs, fora do Git.
/portal/mapa-base/
